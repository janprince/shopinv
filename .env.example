# ---------------------------------------------------------------------------
# JCF Organic — environment configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Set to true for local development only. MUST be false in production.
DJANGO_DEBUG=true

# Required when DJANGO_DEBUG=false. Generate with:  python manage.py generate_secret_key
DJANGO_SECRET_KEY=

# Comma-separated production hostnames. Ignored while DJANGO_DEBUG=true,
# when all hosts are allowed for local/device testing.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated production origins allowed to POST (needed behind a proxy/CDN).
# Debug mode accepts every origin while continuing to validate CSRF tokens.
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL connection string.
#   local (host postgres):  postgres://localhost:5432/jcforganic
#   docker compose:         postgres://jcf:jcf@db:5432/jcforganic
DATABASE_URL=postgres://localhost:5432/jcforganic
DB_SSL_REQUIRE=false
DB_CONN_MAX_AGE=60

# Localisation
DJANGO_TIME_ZONE=Africa/Accra
CURRENCY_SYMBOL=GH₵

# Sessions (seconds). 12 hours covers a full shop day without re-login.
SESSION_COOKIE_AGE=43200

# Production hardening
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=2592000
DJANGO_LOG_LEVEL=INFO

# Used only by `manage.py create_owner --from-env`
OWNER_USERNAME=
OWNER_EMAIL=
OWNER_PASSWORD=
